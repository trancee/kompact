{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trancee.github.io/kompact/schema/kompact-conformance-v1.schema.json",
  "title": "Kompact conformance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "namespace", "schema", "cases"],
  "properties": {
    "formatVersion": { "const": 1 },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorSha256", "id", "packetBytes", "stableName", "version"],
      "properties": {
        "descriptorSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "id": { "type": "integer", "minimum": 1, "maximum": 4095 },
        "packetBytes": { "type": "integer", "minimum": 2 },
        "stableName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "packetHex"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "status": { "type": "string", "pattern": "^0x[0-9A-F]{2}$" },
          "packetHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
          "values": { "type": "object" },
          "error": { "type": "object" }
        }
      }
    }
  }
}
