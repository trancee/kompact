# Maven Central Portal publishing — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# See references/central-release-report.md and .scratch/kompact-spec/issues/14-maven-central-publishing.md

# --- Central Portal API token (https://central.sonatype.com/ → Account → User Tokens) ---
CENTRAL_PORTAL_TOKEN_USERNAME=
CENTRAL_PORTAL_TOKEN_PASSWORD=

# --- Deployment ID (written to build/portal/deployment-id by centralPortalDeploy) ---
# Optionally set this instead of letting the task read the saved file.
CENTRAL_PORTAL_DEPLOYMENT_ID=

# --- PGP signing key (ASCII-armored private key, from `gpg --armor --export-secret-keys`) ---
# SIGNING_KEY_ID: 8-char short key ID (e.g. 8BDD6267), the last 8 hex chars
# of the PGP key fingerprint. Gradle's signing plugin requires this form —
# 16-char long IDs are rejected unless prefixed with 0x. Set this value
# directly (no loader script needed).
SIGNING_KEY=
SIGNING_KEY_ID=
SIGNING_PASSWORD=

# --- CI/CD (GitHub Actions) ---
# RELEASE_PAT must be a **repository-level** secret (NOT just an environment
# secret). The release-pr.yml and release-publish.yml "prepare" job both run
# WITHOUT environment: release, so they can only see repo-level secrets.
#
# The deploy job (which runs in the `release` environment) can see both
# repo-level and environment secrets — repository-level is sufficient.
#
# Other secrets ARE environment secrets on `release` (not repo-level):
# SIGNING_KEY, SIGNING_KEY_ID, SIGNING_PASSWORD,
# CENTRAL_PORTAL_TOKEN_USERNAME, CENTRAL_PORTAL_TOKEN_PASSWORD
#
# Set repo-level: gh secret set RELEASE_PAT --repo trancee/kompact --body "ghp_…"
# Set env-level:   gh secret set <NAME> --repo trancee/kompact --env release --body "…"
